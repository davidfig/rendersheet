{
  "name": "yy-rendersheet",
  "version": "6.0.1",
  "files": [
    "dist",
    "src"
  ],
  "description": "Generate on-the-fly spritesheets for pixi.js",
  "main": "dist/rendersheet.js",
  "scripts": {
    "test": "esbuild docs/code.js --bundle --outfile=docs/index.js --servedir=docs --watch",
    "upgrade": "yarn upgrade-interactive --latest",
    "build-demo": "esbuild docs/code.js --bundle --minify --outfile=docs/index.js",
    "docs": "jsdoc -c .jsdoc.json",
    "transpile": "babel src/ --out-dir dist --source-maps inline",
    "prepublishOnly": "yarn run transpile && yarn run build-demo && yarn run docs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/davidfig/rendersheet.git"
  },
  "author": "david figatner",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davidfig/rendersheet/issues"
  },
  "homepage": "https://github.com/davidfig/rendersheet#readme",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "esbuild": "^0.28.2",
    "fork-me-github": "^1.2.0",
    "highlight.js": "^11.12.0",
    "jsdoc": "^4.0.5",
    "pixi.js": "^8.22.0",
    "yy-counter": "^2.1.0",
    "yy-jsdoc-template": "^1.3.0"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0"
  }
}
